generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  AVAILABLE
  SOLD
  RESERVED
  NFS
}

enum PrintType {
  PAPER
  CANVAS
}

model Work {
  id              String           @id @default(cuid())
  galleryId       String           @map("gallery_id")
  gallery         Gallery          @relation(fields: [galleryId], references: [id])
  title           String
  slug            String           @unique
  status          Status           @default(AVAILABLE)
  subject         String
  mediaType       String?          @map("media_type")
  tags            String[]         @default([])
  year            Int?
  dimensions      String?
  medium          String?
  price           Float?
  originalWidth   Int?
  originalHeight  Int?
  imageUrl        String
  fullResUrl      String?
  thumbUrl        String?
  printsAvailable Boolean          @default(false)
  featured        Boolean          @default(false)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  printProducts   PrintProduct[]
  spotlights      Spotlight[]
  orderItems      OrderItem[]
  contactMessages ContactMessage[]

  @@map("work")
}

model PrintProduct {
  id                String    @id @default(cuid())
  galleryId         String    @map("gallery_id")
  gallery           Gallery   @relation(fields: [galleryId], references: [id])
  workId            String    @map("work_id")
  work              Work      @relation(fields: [workId], references: [id])
  type              PrintType
  size              String
  price             Float
  squareItemId      String?
  squareVariationId String?
  createdAt         DateTime  @default(now())
}

model Spotlight {
  id        String   @id @default(cuid())
  galleryId String   @map("gallery_id")
  gallery   Gallery  @relation(fields: [galleryId], references: [id])
  workId    String   @unique @map("work_id")
  work      Work     @relation(fields: [workId], references: [id])
  position  Int      @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum OrderStatus {
  DRAFT
  INVOICE_SENT
  PAID
  CANCELLED
}

enum CommissionStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETE
  DECLINED
}

model Order {
  id              String      @id @default(cuid())
  galleryId       String      @map("gallery_id")
  gallery         Gallery     @relation(fields: [galleryId], references: [id])
  personId        String?
  person          Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(DRAFT)
  subtotal        Float       @default(0)
  tax             Float       @default(0)
  shipping        Float       @default(0)
  amount          Float       @default(0)
  notes           String?
  publicToken     String?     @unique @map("public_token")
  squarePaymentId String?     @map("square_payment_id")
  squareInvoiceId String?     @map("square_invoice_id")
  squareOrderId   String?     @map("square_order_id")
  inquiryId       String?     @map("inquiry_id")
  commissionId    String?     @map("commission_id")
  sentAt          DateTime?   @map("sent_at")
  paidAt          DateTime?   @map("paid_at")
  items           OrderItem[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("order")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String  @map("order_id")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workId         String? @map("work_id")
  work           Work?   @relation(fields: [workId], references: [id], onDelete: SetNull)
  printProductId String? @map("print_product_id")
  label          String
  quantity       Int     @default(1)
  unitPrice      Float   @map("unit_price")

  @@map("order_item")
}

model Gallery {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  customDomain  String?  @unique @map("custom_domain")
  previewDomain String?  @unique @map("preview_domain")
  cfZoneId      String?  @map("cf_zone_id")
  cfNameservers String[] @default([]) @map("cf_nameservers")
  cfDnsSnapshot Json?    @map("cf_dns_snapshot")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Square OAuth credentials (per gallery)
  squareAccessToken    String?   @map("square_access_token")
  squareRefreshToken   String?   @map("square_refresh_token")
  squareTokenExpiresAt DateTime? @map("square_token_expires_at")
  squareMerchantId     String?   @map("square_merchant_id")
  squareLocationId     String?   @map("square_location_id")

  // Commerce settings
  taxRate Float @default(0) @map("tax_rate")

  memberships     GalleryMembership[]
  config          SiteConfig?
  works           Work[]
  printProducts   PrintProduct[]
  spotlights      Spotlight[]
  orders          Order[]
  contacts        ContactMessage[]
  commissions     CommissionRequest[]
  subscribers     NewsletterSubscriber[]
  socialLinks     SocialLink[]
  slides          SlideshowSlide[]
  analytics       DailyAnalytics[]
  events          Event[]
  classOfferings  ClassOffering[]
  supportMessages SupportMessage[]
  supportLogs     SupportLog[]
  personLinks     PersonGalleryLink[]

  @@map("gallery")
}

model GalleryMembership {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  galleryId String   @map("gallery_id")
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([personId, galleryId])
  @@map("gallery_membership")
}

model Person {
  id              String                @id @default(cuid())
  name            String
  email           String                @unique
  phone           String?
  shippingAddress String?               @map("shipping_address")
  notes           String?
  tags            String[]              @default([])
  isAppAdmin      Boolean               @default(false) @map("is_app_admin")
  passwordHash    String?               @map("password_hash")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  contacts        ContactMessage[]
  commissions     CommissionRequest[]
  newsletter      NewsletterSubscriber?
  orders          Order[]
  sessions        RefreshToken[]
  resetTokens     PasswordResetToken[]
  memberships     GalleryMembership[]
  galleryLinks    PersonGalleryLink[]
}

// Manual anchor for People-tab visibility. The four organic paths (contact, commission,
// newsletter, order) already give a Person a gallery-scoped child record to be found by;
// a person created directly via "+ Add Person" has none, so this is what makes them show up
// in that gallery's People list at all. Also lets a Person who already exists globally (e.g.
// from contacting a different gallery) get linked into a new gallery without a duplicate
// record — email stays globally unique.
model PersonGalleryLink {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  galleryId String   @map("gallery_id")
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([personId, galleryId])
  @@map("person_gallery_link")
}

model RefreshToken {
  id        String    @id @default(cuid())
  personId  String    @map("person_id")
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_token")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  personId  String    @map("person_id")
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_token")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  galleryId    String   @map("gallery_id")
  gallery      Gallery  @relation(fields: [galleryId], references: [id])
  personId     String   @unique
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  active       Boolean  @default(true)
  source       String?
  sourceSite   String?  @map("source_site")
  subscribedAt DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(cuid())
  galleryId  String   @map("gallery_id")
  gallery    Gallery  @relation(fields: [galleryId], references: [id])
  personId   String?
  person     Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  workId     String?  @map("work_id")
  work       Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  read       Boolean  @default(false)
  sourceSite String?  @map("source_site")
  createdAt  DateTime @default(now())
}

model CommissionRequest {
  id          String           @id @default(cuid())
  galleryId   String           @map("gallery_id")
  gallery     Gallery          @relation(fields: [galleryId], references: [id])
  personId    String?
  person      Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  subject     String
  description String
  status      CommissionStatus @default(NEW)
  adminNotes  String?
  createdAt   DateTime         @default(now())
}

model SiteConfig {
  id                 String   @id @default("singleton")
  galleryId          String   @unique @map("gallery_id")
  gallery            Gallery  @relation(fields: [galleryId], references: [id])
  taglinePrimary     String?  @map("tagline_primary")
  taglineSecondary   String?  @map("tagline_secondary")
  taglineFooter      String?  @map("tagline_footer")
  heroImageUrl       String?  @map("hero_image_url")
  heroThumbUrl       String?  @map("hero_thumb_url")
  heroFullResUrl     String?  @map("hero_full_res_url")
  commissionsEnabled Boolean  @default(true) @map("commissions_enabled")
  commissionTitle    String?  @map("commission_title")
  commissionBody     String[] @default([]) @map("commission_body")
  featuredEnabled    Boolean  @default(true) @map("featured_enabled")
  featuredCount      Int      @default(6) @map("featured_count")
  newsletterEnabled  Boolean  @default(true) @map("newsletter_enabled")
  newsletterTitle    String?  @map("newsletter_title")
  newsletterTagline  String?  @map("newsletter_tagline")
  eventsEnabled      Boolean  @default(true) @map("events_enabled")
  blogEnabled        Boolean  @default(false) @map("blog_enabled")
  musicEnabled       Boolean  @default(false) @map("music_enabled")
  classesEnabled     Boolean  @default(false) @map("classes_enabled")
  showPrice          Boolean  @default(true) @map("show_price")
  mediaTypes         String[] @default([]) @map("media_types")
  worksLabel         String?  @map("works_label")
  theme              String?  @map("theme_id")

  // Site Info
  contactEmail    String? @map("contact_email")
  contactPhone    String? @map("contact_phone")
  businessAddress String? @map("business_address")
  studioLocation  String? @map("studio_location")
  timezone        String?
  metaDescription String? @map("meta_description")
  ogImageUrl      String? @map("og_image_url")

  // Contact
  contactHeading      String?  @map("contact_heading")
  contactBody         String[] @default([]) @map("contact_body")
  studioImageUrl      String?  @map("studio_image_url")
  contactImageCaption String?  @map("contact_image_caption")

  // About Page
  aboutName          String?  @map("about_name")
  aboutBioSubtitle   String?  @map("about_bio_subtitle")
  aboutBio           String[] @default([]) @map("about_bio")
  aboutStatSubtitle  String?  @map("about_stat_subtitle")
  aboutStatement     String[] @default([]) @map("about_statement")
  profileImageUrl    String?  @map("profile_image_url")
  profileThumbUrl    String?  @map("profile_thumb_url")
  profileFullResUrl  String?  @map("profile_full_res_url")
  aboutStatImage1Url String?  @map("about_stat_image1_url")
  aboutStatImage2Url String?  @map("about_stat_image2_url")
  aboutShows         Json     @default("[]") @map("about_shows")
  aboutAwards        Json     @default("[]") @map("about_awards")
  aboutMedia         Json     @default("[]") @map("about_media")
  aboutGalleries     Json     @default("[]") @map("about_galleries")
  aboutMemberships   Json     @default("[]") @map("about_memberships")

  // Classes page
  classesLabel    String? @map("classes_label")
  classesHeading  String? @map("classes_heading")
  classesImageUrl String? @map("classes_image_url")

  // Branding
  logoUrl String? @map("logo_url")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

model SocialLink {
  id        String   @id @default(cuid())
  galleryId String   @map("gallery_id")
  gallery   Gallery  @relation(fields: [galleryId], references: [id])
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([position])
  @@map("social_link")
}

model SlideshowSlide {
  id         String   @id @default(cuid())
  galleryId  String   @map("gallery_id")
  gallery    Gallery  @relation(fields: [galleryId], references: [id])
  context    String
  imageUrl   String   @map("image_url")
  thumbUrl   String?  @map("thumb_url")
  fullResUrl String?  @map("full_res_url")
  caption    String?
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([context, position])
  @@map("slideshow_slide")
}

model Event {
  id           String   @id @default(cuid())
  galleryId    String   @map("gallery_id")
  gallery      Gallery  @relation(fields: [galleryId], references: [id])
  title        String
  date         DateTime @map("event_date") @db.Date
  time         String?  @map("event_time")
  venue        String
  description  String?
  externalLink String?  @map("external_link")
  imageUrl     String?  @map("image_url")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([galleryId, date])
  @@map("event")
}

model ClassOffering {
  id             String   @id @default(cuid())
  galleryId      String   @map("gallery_id")
  gallery        Gallery  @relation(fields: [galleryId], references: [id])
  label          String
  heading        String
  description    String
  inquireSubject String   @map("inquire_subject")
  sortOrder      Int      @default(0) @map("sort_order")
  published      Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([galleryId, sortOrder])
  @@map("class_offering")
}

model DailyAnalytics {
  id             String   @id @default(cuid())
  galleryId      String   @map("gallery_id")
  gallery        Gallery  @relation(fields: [galleryId], references: [id])
  date           DateTime @db.Date
  uniqueVisitors Int      @map("unique_visitors")
  pageViews      Int      @map("page_views")
  requests       Int
  bandwidth      Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([date, galleryId])
  @@map("daily_analytics")
}

model SupportMessage {
  id        String   @id @default(cuid())
  galleryId String   @map("gallery_id")
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([galleryId, createdAt])
  @@map("support_message")
}

model SupportLog {
  id        String   @id @default(cuid())
  galleryId String   @map("gallery_id")
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  category  String // 'suggestion' | 'bug' | 'escalation'
  priority  String // 'low' | 'medium' | 'high'
  summary   String
  detail    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("support_log")
}
